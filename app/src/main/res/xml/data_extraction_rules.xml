<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup/device-transfer is disabled in AndroidManifest.xml.

    This file is intentionally restrictive in case backup is re-enabled later.
    Do not back up WebView cookies, local storage, caches, or session data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>

    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
